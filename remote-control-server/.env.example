# Remote Control Relay Server Configuration

# Port to listen on
PORT=8080

# Allowed origins (comma-separated)
# Development: http://localhost:5173
# Production: https://your-site.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Session secret for token signing
# IMPORTANT: Change this in production to a strong random value
REMOTE_SESSION_SECRET=dev-secret-change-in-production

# Environment
NODE_ENV=development

# Supabase (optional, for future integration)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
